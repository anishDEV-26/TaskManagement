<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Employee Portal</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        @@keyframes activePing {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            100% {
                transform: scale(2.5);
                opacity: 0;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', Arial, sans-serif;
        }

        body {
            background: #f0f4f8;
        }

        .emp-layout-sidebar {
            width: 270px;
            height: 100vh;
            background: linear-gradient(180deg, #0a1f1c 0%, #0f2922 40%, #112e26 100%);
            position: fixed;
            left: 0;
            top: 0;
            overflow: hidden;
            border-right: 1px solid rgba(255,255,255,0.05);
            display: flex;
            flex-direction: column;
            z-index: 10;
        }

            .emp-layout-sidebar::before {
                content: '';
                position: absolute;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(13,148,136,0.18) 0%, transparent 70%);
                top: -60px;
                left: -60px;
                border-radius: 50%;
                pointer-events: none;
            }

        .emp-layout-logo {
            padding: 26px 24px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            position: relative;
            z-index: 1;
        }

        .emp-layout-logo-inner {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .emp-layout-logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #0d9488, #0f766e);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
            box-shadow: 0 4px 14px rgba(13,148,136,0.45);
            flex-shrink: 0;
        }

        .emp-layout-logo-text {
            color: white;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.2px;
        }

        .emp-layout-logo-sub {
            color: rgba(255,255,255,0.4);
            font-size: 11px;
            font-weight: 400;
            margin-top: 2px;
        }

        .emp-sidebar-user {
            margin: 18px 16px 0;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            gap: 11px;
            position: relative;
            z-index: 1;
        }

        .emp-sidebar-user-avatar {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #0d9488, #0e7490);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .emp-sidebar-user-name {
            color: white;
            font-size: 13px;
            font-weight: 600;
        }

        .emp-sidebar-user-role {
            color: rgba(255,255,255,0.45);
            font-size: 11px;
            margin-top: 1px;
        }

        .emp-sidebar-online {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            margin-left: auto;
            flex-shrink: 0;
            position: relative;
        }

            .emp-sidebar-online::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 50%;
                background: #22c55e;
                animation: activePing 1.5s ease-out infinite;
            }

        .emp-menu-label {
            color: rgba(255,255,255,0.25);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            padding: 18px 24px 8px;
            position: relative;
            z-index: 1;
        }

        .emp-layout-menu {
            flex: 1;
            overflow-y: auto;
            padding: 6px 12px 12px;
            position: relative;
            z-index: 1;
            scrollbar-width: none;
        }

            .emp-layout-menu::-webkit-scrollbar {
                display: none;
            }

            .emp-layout-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.6);
                text-decoration: none;
                padding: 11px 14px;
                border-radius: 12px;
                transition: all 0.22s ease;
                font-size: 14px;
                font-weight: 500;
                margin-bottom: 2px;
                position: relative;
                overflow: hidden;
            }

                .emp-layout-menu a .menu-icon {
                    width: 34px;
                    height: 34px;
                    border-radius: 9px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 14px;
                    background: rgba(255,255,255,0.06);
                    transition: all 0.22s ease;
                    flex-shrink: 0;
                }

                .emp-layout-menu a:hover {
                    background: rgba(13,148,136,0.18);
                    color: white;
                    transform: translateX(4px);
                }

                    .emp-layout-menu a:hover .menu-icon {
                        background: rgba(13,148,136,0.35);
                        color: #2dd4bf;
                    }

                .emp-layout-menu a.active {
                    background: linear-gradient(135deg, rgba(13,148,136,0.32), rgba(13,148,136,0.15));
                    color: white;
                    border: 1px solid rgba(13,148,136,0.3);
                }

                    .emp-layout-menu a.active .menu-icon {
                        background: #0d9488;
                        color: white;
                        box-shadow: 0 4px 12px rgba(13,148,136,0.4);
                    }

                    .emp-layout-menu a.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 20%;
                        bottom: 20%;
                        width: 3px;
                        background: #0d9488;
                        border-radius: 0 3px 3px 0;
                    }

                .emp-layout-menu a.logout-link:hover {
                    background: rgba(239,68,68,0.15);
                }

                    .emp-layout-menu a.logout-link:hover .menu-icon {
                        background: rgba(239,68,68,0.25);
                        color: #f87171;
                    }

        .emp-sidebar-bottom {
            padding: 14px 16px;
            border-top: 1px solid rgba(255,255,255,0.06);
            position: relative;
            z-index: 1;
        }

        .emp-sidebar-version {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.04);
            border-radius: 10px;
            padding: 9px 12px;
        }

            .emp-sidebar-version i {
                color: rgba(255,255,255,0.3);
                font-size: 13px;
            }

            .emp-sidebar-version span {
                color: rgba(255,255,255,0.3);
                font-size: 11px;
            }

        .emp-layout-topbar {
            height: 70px;
            background: white;
            margin-left: 270px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            box-shadow: 0 1px 0 #e2e8f0, 0 4px 20px rgba(0,0,0,0.04);
            position: sticky;
            top: 0;
            z-index: 9;
        }

        .emp-layout-topbar-title {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.3px;
        }

        .emp-topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 6px 12px 6px 7px;
            cursor: pointer;
            transition: 0.2s;
        }

            .emp-topbar-user:hover {
                background: #f0fdfa;
                border-color: #99f6e4;
            }

        .emp-topbar-avatar {
            width: 30px;
            height: 30px;
            background: linear-gradient(135deg, #0d9488, #0e7490);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
            font-weight: 700;
        }

        .emp-topbar-username {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
        }

        .emp-layout-content {
            margin-left: 270px;
            padding: 28px 32px;
            min-height: calc(100vh - 70px);
        }

        .dataTables_wrapper {
            background: white;
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            border: 1px solid #f1f5f9;
            margin-top: 10px;
        }

        table.dataTable {
            border-collapse: separate !important;
            border-spacing: 0 6px !important;
            width: 100% !important;
        }

            table.dataTable thead th {
                background: #f0fdfa !important;
                color: #0f766e !important;
                font-size: 12px !important;
                font-weight: 700 !important;
                letter-spacing: 0.6px !important;
                text-transform: uppercase !important;
                padding: 14px 16px !important;
                border: none !important;
                white-space: nowrap;
            }

            table.dataTable tbody tr {
                background: #ffffff !important;
                border-radius: 12px !important;
                box-shadow: 0 1px 4px rgba(0,0,0,0.04) !important;
            }

            table.dataTable tbody td {
                padding: 14px 16px !important;
                font-size: 13.5px !important;
                color: #334155 !important;
                border: none !important;
                border-top: 1px solid #f1f5f9 !important;
                vertical-align: middle !important;
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff7ed;
            color: #ea580c;
        }

        .status-inprogress {
            background: #f0fdfa;
            color: #0d9488;
        }

        .status-completed {
            background: #f0fdf4;
            color: #16a34a;
        }
    </style>
</head>
<body>
    <div class="emp-layout-sidebar">
        <div class="emp-layout-logo">
            <div class="emp-layout-logo-inner">
                <div class="emp-layout-logo-icon"><i class="fa-solid fa-user-tie"></i></div>
                <div>
                    <div class="emp-layout-logo-text">Employee Portal</div>
                    <div class="emp-layout-logo-sub">Task Management</div>
                </div>
            </div>
        </div>
        <div class="emp-sidebar-user">
            <div class="emp-sidebar-user-avatar">@(Session["FullName"] != null ? Session["FullName"].ToString().Substring(0,1).ToUpper() : "E")</div>
            <div>
                <div class="emp-sidebar-user-name">@Session["FullName"]</div>
                <div class="emp-sidebar-user-role">@Session["Role"]</div>
            </div>
            <div class="emp-sidebar-online"></div>
        </div>
        <div class="emp-menu-label">Main Menu</div>
        <div class="emp-layout-menu" id="empSidebarMenu">
            <a href="/Employee/Index"><div class="menu-icon"><i class="fa-solid fa-list-check"></i></div>My Tasks</a>
            <a href="/Employee/UpdateProgress"><div class="menu-icon"><i class="fa-solid fa-chart-simple"></i></div>Update Progress</a>
            <a href="/Employee/Calendar"><div class="menu-icon"><i class="fa-solid fa-calendar-days"></i></div>Calendar</a>
            <a href="/Employee/Profile"><div class="menu-icon"><i class="fa-solid fa-user"></i></div>My Profile</a>
            <a href="/Employee/Notifications"><div class="menu-icon"><i class="fa-solid fa-bell"></i></div>Notifications</a>
            <a href="/Employee/Documents"><div class="menu-icon"><i class="fa-solid fa-file-pdf"></i></div>Documents</a>
            <div class="emp-menu-label" style="padding-left:0;margin-top:8px;">Account</div>
            <a href="/Employee/Logout" class="logout-link"><div class="menu-icon"><i class="fa-solid fa-right-from-bracket"></i></div>Logout</a>
        </div>
        <div class="emp-sidebar-bottom">
            <div class="emp-sidebar-version"><i class="fa-solid fa-circle-check"></i><span>All systems operational</span></div>
        </div>
    </div>
    <div class="emp-layout-topbar">
        <div class="emp-layout-topbar-title">@ViewBag.Title</div>
        <div class="emp-topbar-user">
            <div class="emp-topbar-avatar">@(Session["FullName"] != null ? Session["FullName"].ToString().Substring(0,1).ToUpper() : "E")</div>
            <span class="emp-topbar-username">@Session["FullName"]</span>
        </div>
    </div>
    <div class="emp-layout-content">@RenderBody()</div>
    <script>(function () {
            let path = window.location.pathname.toLowerCase();
            document.querySelectorAll('#empSidebarMenu a').forEach(function (a) {
                if (a.getAttribute('href') && path === a.getAttribute('href').toLowerCase()) {
                    a.classList.add('active');
                }
            });
        })();</script>
</body>
</html>